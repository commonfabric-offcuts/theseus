--- a/.github/workflows/verdict.yml
+++ b/.github/workflows/verdict.yml
@@ -518,6 +518,20 @@
             refuse "the controller's own commit $GITHUB_WORKFLOW_SHA is not a commit on the default branch $DEFAULT_BRANCH"
           fi
           echo "ready=true" >> "$GITHUB_OUTPUT"
+      - uses: actions/setup-node@v4
+        if: steps.controller.outputs.ready == 'true'
+        with:
+          node-version: '26'
+      - name: Authenticate every original producer archive
+        if: steps.merge.outputs.ready == 'true' && steps.controller.outputs.ready == 'true'
